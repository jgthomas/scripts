#!/bin/bash

set -euo pipefail

fail() {
    printf 'repo-publish: %s\n' "$*" >&2
    exit 1
}

if (( $# < 2 )); then
    fail 'Usage: repo-publish {add|remove|clean-db|clean-files} <database> [package ...]'
fi

action=$1
database=$2
shift 2
case "$action" in
    add) (( $# == 1 )) || fail 'Supply one package archive' ;;
    remove) (( $# > 0 )) || fail 'Supply at least one package name' ;;
    clean-db|clean-files) (( $# == 0 )) || fail 'Supply only a database for cleanup' ;;
    *) fail "Unknown action: $action" ;;
esac

repo_dir=$(cd -P -- "$(dirname -- "$database")" && pwd)
db_name=${database##*/}
[[ $db_name == *.db.tar.* ]] || fail "Invalid database filename: $db_name"
repo_name=${db_name%.db.tar.*}
files_name="$repo_name.files.tar.${db_name##*.db.tar.}"
database="$repo_dir/$db_name"
lockfile="$database.lck"
stage=
committed=false
replaced=()

cleanup() {
    local status=$? file index restore_failed=false
    trap - EXIT
    if ! $committed && (( ${#replaced[@]} )); then
        for (( index=${#replaced[@]}-1; index>=0; index-- )); do
            file=${replaced[index]}
            if [[ -e "$stage/previous/$file" || -L "$stage/previous/$file" ]]; then
                mv -fT -- "$stage/previous/$file" "$repo_dir/$file" || restore_failed=true
            else
                rm -f -- "$repo_dir/$file" || restore_failed=true
            fi
        done
    fi
    if $restore_failed; then
        printf 'repo-publish: could not restore all repository files. Backups remain at %s\n' "$stage/previous" >&2
        status=1
    elif [[ -n $stage ]]; then
        rm -rf -- "$stage" || status=1
    fi
    rm -f -- "$lockfile" || status=1
    exit "$status"
}

# Use the same lock as repo-add and repo-remove, including aurutils callers.
if ! (set -o noclobber; printf '%s\n' "$$" > "$lockfile") 2>/dev/null; then
    fail "Cannot lock $database; check for another repository update"
fi
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

read_index() {
    local listing member
    local -a descriptions=()
    listing=$(bsdtar -tf "$database") || return
    while IFS= read -r member; do
        [[ $member == */desc ]] && descriptions+=("$member")
    done <<< "$listing"
    (( ${#descriptions[@]} )) || return 0

    bsdtar -xOf "$database" -- "${descriptions[@]}" |
        awk '
            $0 == "%NAME%" { if (getline <= 0 || !length($0) || name) exit 1; name = $0 }
            $0 == "%FILENAME%" { if (getline <= 0 || !length($0) || filename) exit 1; filename = $0 }
            name && filename { print name "\t" filename; name = filename = "" }
            END { if (name || filename) exit 1 }
        '
}

load_index() {
    local entries name filename
    entries=$(read_index) || fail "Cannot read package metadata from $database"
    declare -gA indexed=()
    while IFS=$'\t' read -r name filename; do
        [[ -n $name ]] || continue
        [[ $filename == *.pkg.tar || $filename == *.pkg.tar.* ]] || fail "Invalid archive name: $filename"
        [[ $filename != */* ]] || fail "Invalid archive path: $filename"
        indexed["$name"]=$filename
    done <<< "$entries"
}

confirm() {
    local answer
    read -r -p "$1 [y/N]: " answer && [[ ${answer,,} =~ ^(y|yes)$ ]]
}

clean_files() {
    local file archive metadata name
    local -a orphans=()
    shopt -s nullglob
    for file in "$repo_dir"/*.pkg.tar "$repo_dir"/*.pkg.tar.*; do
        if [[ $file == *.sig ]]; then
            [[ -f $file || -L $file ]] || continue
            archive=${file%.sig}
            [[ -f $archive ]] || orphans+=("$file")
            continue
        fi

        [[ -f $file ]] || continue
        metadata=$(bsdtar -xqOf "$file" .PKGINFO) || fail "Cannot read package metadata from $file"
        name=$(awk -F ' = ' '$1 == "pkgname" { print $2 }' <<< "$metadata")
        [[ -n $name ]] || fail "Missing package name in $file"
        if [[ ! -v 'indexed[$name]' ]]; then
            orphans+=("$file")
            [[ ! -e "$file.sig" && ! -L "$file.sig" ]] || orphans+=("$file.sig")
        fi
    done
    if (( ${#orphans[@]} == 0 )); then
        printf 'No orphan files found in %s.\n' "$repo_name"
    else
        printf 'Orphan files in %s:\n' "$repo_name"
        printf '  %s\n' "${orphans[@]##*/}"
        if confirm 'Delete these orphan files?'; then
            rm -f -- "${orphans[@]}"
            printf 'Cleanup complete.\n'
        fi
    fi
}

if [[ $action == clean-db || $action == clean-files ]]; then
    load_index
    if [[ $action == clean-files ]]; then
        clean_files
        exit 0
    fi

    missing=()
    for name in "${!indexed[@]}"; do
        [[ -f "$repo_dir/${indexed[$name]}" ]] || missing+=("$name")
    done
    if (( ${#missing[@]} == 0 )); then
        printf 'No missing indexed archives in %s.\n' "$repo_name"
        exit 0
    fi

    printf 'Missing indexed archives in %s:\n' "$repo_name"
    for name in "${missing[@]}"; do
        printf '  %s\n' "${indexed[$name]}"
    done
    confirm 'Remove these database entries?' || exit 0
    action=remove
    set -- "${missing[@]}"
fi

export GNUPGHOME="$HOME/.local/share/pacman-repo-signing"
keys=$(gpg --batch --with-colons --list-secret-keys)
fingerprint=$(awk -F: '$1 == "sec" { primary = 1 }
                       $1 == "fpr" && primary { print $10; primary = 0 }' <<< "$keys")
[[ $fingerprint =~ ^[0-9A-F]{40}$ ]] || fail "Expected exactly one signing key in $GNUPGHOME"

verify_signature() {
    gpg --batch --assert-signer "$fingerprint" --verify "$1.sig" "$1"
}

stage=$(mktemp -d -- "$repo_dir/.repo-publish.XXXXXXXX")
mkdir -- "$stage/previous"
for archive in "$db_name" "$files_name"; do
    if [[ -e "$repo_dir/$archive.sig" || -L "$repo_dir/$archive.sig" ]]; then
        verify_signature "$repo_dir/$archive"
        cp -- "$repo_dir/$archive.sig" "$stage/$archive.sig"
    fi
    if [[ -f "$repo_dir/$archive" ]]; then
        cp -- "$repo_dir/$archive" "$stage/$archive"
    fi
done

if [[ $action == add ]]; then
    package_name=${1##*/}
    case "$package_name" in
        *.sig) fail 'Supply a package archive' ;;
        *.pkg.tar|*.pkg.tar.*) ;;
        *) fail 'Supply a package archive' ;;
    esac
    for file in "$package_name" "$package_name.sig"; do
        [[ ! -e "$repo_dir/$file" && ! -L "$repo_dir/$file" ]] ||
            fail "Already exists in the repository: $file"
    done
    install -m 644 -- "$1" "$stage/$package_name"
    gpg --batch --no-armor --local-user "$fingerprint" --detach-sign \
        --output "$stage/$package_name.sig" -- "$stage/$package_name"
    verify_signature "$stage/$package_name"
    repo-add --include-sigs --sign --key "$fingerprint" -- "$stage/$db_name" "$stage/$package_name"
else
    repo-remove --sign --key "$fingerprint" -- "$stage/$db_name" "$@"
fi

# repo-add can return success after a signing failure, so check both outputs.
for archive in "$db_name" "$files_name"; do
    verify_signature "$stage/$archive"
done

replace_live() {
    local file=$1 target="$repo_dir/$1"
    if [[ -e $target || -L $target ]]; then
        [[ ! -d $target || -L $target ]] || fail "Expected a file at $target"
        cp -a -- "$target" "$stage/previous/$file"
    fi
    replaced+=("$file")
    if [[ -e "$stage/$file" || -L "$stage/$file" ]]; then
        mv -fT -- "$stage/$file" "$target"
    else
        rm -f -- "$target"
    fi
}

if [[ $action == add ]]; then
    replace_live "$package_name"
    replace_live "$package_name.sig"
fi
for archive in "$files_name" "$db_name"; do
    short_name=${archive%.tar.*}
    replace_live "$archive.old"
    replace_live "$archive.old.sig"
    replace_live "$archive.sig"
    replace_live "$archive"
    replace_live "$short_name.sig"
    replace_live "$short_name"
done
committed=true
