[Trigger]
Operation = Remove
Operation = Install
Operation = Upgrade
Type = Package
Target = *

[Action]
Description = Checking for .pacnew and .pacsave files
When = PostTransaction
Depends = pacman-contrib
Exec = /usr/bin/bash -c 'pacnews=$(/usr/bin/pacdiff --find -o); if [[ -z $pacnews ]]; then echo "==> no .pacnew or .pacsave files found"; else echo "$pacnews"; fi'
