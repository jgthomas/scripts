pkgname=addcustom
pkgver=1.6
pkgrel=1
pkgdesc="Add a package to the custom repository"
arch=('any')
url="https://github.com/jgthomas/scripts"
license=('GPL3')
source=("${pkgname}"
        "rmcustom")
md5sums=('SKIP' 'SKIP')


package() {

        install -D -m755 "$srcdir/${pkgname}" "$pkgdir/usr/bin/${pkgname}"
        install -D -m755 "$srcdir/rmcustom" "$pkgdir/usr/bin/rmcustom"

}

