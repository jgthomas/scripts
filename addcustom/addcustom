#!/bin/bash

REPO_DIR="/srv/custom"
REPO_NAME="custom.db.tar.gz"
PACKAGE_NAME="$1"

if [[ -z "$PACKAGE_NAME" ]]; then
        echo "Must supply a package file" >&2
        exit 1
fi

if [[ ! -f "$PACKAGE_NAME" ]]; then
        echo "Package file not found: $PACKAGE_NAME" >&2
        exit 1
fi

PACKAGE_DEST="$REPO_DIR/${PACKAGE_NAME##*/}"

if [[ -e "$PACKAGE_DEST" || -L "$PACKAGE_DEST" ]]; then
        echo "Package already exists in repository: $PACKAGE_DEST" >&2
        exit 1
fi

if ! cp -- "$PACKAGE_NAME" "$PACKAGE_DEST"; then
        echo "Failed to copy package to $REPO_DIR" >&2
        exit 1
fi

if ! repo-add "$REPO_DIR/$REPO_NAME" "$PACKAGE_DEST"; then
        rm -- "$PACKAGE_DEST"
        echo "Failed to add package; original remains at $PACKAGE_NAME" >&2
        exit 1
fi

if ! rm -- "$PACKAGE_NAME"; then
        echo "Package added, but failed to remove original: $PACKAGE_NAME" >&2
        exit 1
fi

echo "Package moved to $REPO_DIR"

echo

rm -rf src/ pkg/ && echo "Deleted build directories"
