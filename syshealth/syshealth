#!/bin/bash

# Assign script name
PROGRAM=$(basename $0)

# Assign colours and formatting
BOLD=$(tput bold)
RED=$(tput setaf 1)
GREEN=$(tput setaf 2)
NORMAL=$(tput sgr0)

RUN_COMMANDS=true

CORE_COUNT=$(nproc)

OK="OK"
PROBLEM="ACTION"


print_ok() {
        printf '%s\n' "${GREEN}$OK${NORMAL}"
}


print_problem() {
        printf '%s\n' "${RED}$PROBLEM${NORMAL}"
}


check_syshealth() {
        [[ "$1" == "quiet" ]] && RUN_COMMANDS=false || RUN_COMMANDS=true

        printf '\n%s\n\n' "Running system health check..."
        failed_unit_check
        clock_synchronized_check
        disk_space_home_check
        disk_space_root_check
        ram_free_check
        swap_used_check
}


failed_unit_check() {
        printf '%s' "Failed unit files: "
        local failed_units
        if failed_units=$(systemctl list-units --failed --no-legend --no-pager 2>&1); then
                if [[ -z $failed_units ]]; then
                        print_ok
                else
                        print_problem
                        if [[ $RUN_COMMANDS = true ]]; then printf '%s\n' "$failed_units"; fi
                fi
        else
                print_problem
                if [[ $RUN_COMMANDS = true ]]; then printf '%s\n' "$failed_units"; fi
        fi
}


disk_space_check() {
        printf '%s' "Disk space used ${BOLD}$1${NORMAL}: "
        df -hT "$1" | awk 'FNR == 2 { print $6 }'
}


disk_space_home_check() {
        disk_space_check "/home"
}


disk_space_root_check() {
        disk_space_check "/"
}


ram_free_check() {
        printf '%s' "Available memory: "
        free -h --giga | awk 'FNR == 2 { print $7 }'
}


swap_used_check() {
        printf '%s' "Swap used: "
        free -h --giga | awk 'FNR == 3 { print $3 }'
}


clock_property_check() {
        local label=$1
        local property=$2
        local value
        printf '%s' "$label: "
        if value=$(timedatectl show --property="$property" --value 2>&1); then
                [[ $value == yes ]] && print_ok || print_problem
        else
                print_problem
                if [[ $RUN_COMMANDS = true ]]; then printf '%s\n' "$value"; fi
        fi
}

clock_synchronized_check() {
        clock_property_check "System clock synchronized" NTPSynchronized
        clock_property_check "Network time protocol active" NTP
}


check_syshealth $@
